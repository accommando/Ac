rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Campaign Validation
    function isValidCampaign(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.prompt is string && data.prompt.size() > 0 && data.prompt.size() <= 2000 &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 500 &&
             data.body is string && data.body.size() > 0 && data.body.size() <= 10000 &&
             data.status in ['draft', 'sent', 'archived'] &&
             data.ownerId == request.auth.uid &&
             data.createdAt is timestamp;
    }

    // Campaigns collection
    match /campaigns/{campaignId} {
      allow get: if isSignedIn() && isOwner(existing().ownerId);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                      isValidId(campaignId) &&
                      isValidCampaign(incoming()) &&
                      incoming().createdAt == request.time;
      
      allow update: if isSignedIn() && 
                      isOwner(existing().ownerId) &&
                      isValidCampaign(incoming()) &&
                      incoming().ownerId == existing().ownerId &&
                      incoming().createdAt == existing().createdAt && (
                        // Regular updates: status, name, prompt, subject, body, imageUrl
                        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'prompt', 'subject', 'body', 'status', 'imageUrl']) ||
                        // Stats increments
                        incoming().diff(existing()).affectedKeys().hasOnly(['stats'])
                      );
      
      allow delete: if isSignedIn() && isOwner(existing().ownerId);
    }

    // User stats
    match /users/{userId}/stats {
       allow get: if isSignedIn() && isOwner(userId);
       // Only system or owner can update stats (usually via logic that increments/decrements)
       allow write: if isSignedIn() && isOwner(userId);
    }
  }
}
